<resources>
    <style name="Theme.SpeedReader" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sr_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- System splash screen (Android 12+): logo on the app's dark background. -->
        <item name="android:windowSplashScreenBackground">@color/sr_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
